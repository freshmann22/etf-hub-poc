# ETF 허브 — 환경설정 예시(.env.example)
#
# 사용법:
#   1) 이 파일을 프로젝트 루트에 `.env` 로 복사한다:  cp .env.example .env
#   2) 아래 값 중 사용할 provider 의 자격정보만 직접 채운다.
#   3) `npm run serve` 로 기동한다.
#
# 원칙:
#   - 실제 인증정보/API 키는 "사용자가 직접" 입력한다. 저장소에는 값이 없는 이 예시만 커밋한다.
#   - `.env` 는 .gitignore 로 제외된다(커밋 금지).
#   - 자격정보가 없는 provider 는 서버를 실패시키지 않고 "unavailable" 로 정직하게 표기된다.
#   - 어떤 값도 비워두면 mock(로컬 샘플 데이터)로 동작하므로 자격 없이도 화면이 뜬다.

# ---------------------------------------------------------------------------
# 데이터 모드
# ---------------------------------------------------------------------------
# mock   : 로컬 샘플 데이터만 사용(기본). 자격정보 불필요.
# live   : 실 provider 만 사용. 실패/미지원 시 데이터를 지어내지 않고 unavailable 로 표기.
# hybrid : 실 provider 우선, 실패 시 mock 으로 폴백(폴백 사실을 meta 에 표시).
ETF_DATA_MODE=mock

# 화면 초기 번들(/api/bundle)에 실 시세(종가·등락률)를 덧입힐지 여부.
# true 이고 모드가 mock 이 아니면, 단위 호환 필드(종가 KRW·등락률 %)만 덧입힌다.
# 구조(테마·구성종목 관계·비교셋·시장요약)는 항상 fixture 스캐폴드를 사용한다.
ETF_BUNDLE_OVERLAY=false

# 서버 포트(기본 4173)
PORT=4173

# ---------------------------------------------------------------------------
# 캐시 / HTTP (선택 — 미설정 시 기본값)
# ---------------------------------------------------------------------------
CACHE_TTL_PRICE_SECONDS=60
CACHE_TTL_METADATA_SECONDS=86400
CACHE_TTL_HOLDINGS_SECONDS=21600
CACHE_SWR_SECONDS=120
HTTP_TIMEOUT_MS=8000
HTTP_RETRIES=2

# ---------------------------------------------------------------------------
# 토스증권 Open API (openapi.tossinvest.com) — 실 시세 채널 [권장]
# ---------------------------------------------------------------------------
# OAuth2 client_credentials 로 액세스 토큰을 발급받아 국내(KRX) ETF/주식 현재가·일봉을 조회한다.
# 발급: 토스증권 홈페이지 > Open API 신청 후 client_id/client_secret 발급(사전 신청 대상 단계적 롤아웃).
# 아래에 본인 값을 직접 입력한다(예시값 없음). 시세 등락률은 일봉(전일종가)으로 서버가 계산한다.
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
# 토큰 URL(기본값 사용 시 비워도 됨): https://openapi.tossinvest.com/oauth2/token
TOSS_TOKEN_URL=
# API base URL(기본값 사용 시 비워도 됨): https://openapi.tossinvest.com
TOSS_API_BASE_URL=

# ---------------------------------------------------------------------------
# KRX 한국거래소 데이터 (data.krx.co.kr / openapi.krx.co.kr)
# ---------------------------------------------------------------------------
# [주의] KRX 데이터 API 는 포털 로그인 ID/PW 로 호출하지 않는다. 공식 KRX Open API
#        (openapi.krx.co.kr)는 로그인 후 "API 인증키(AUTH_KEY)"를 별도 발급받아 사용해야 한다.
#        본 코드의 krx provider 는 인증키 없는 공개 엔드포인트(data.krx.co.kr)를 "베스트에포트"로
#        시도하나, 최근 로그인/인증 요구·엔드포인트 변경으로 실패(400)할 수 있다.
#        → 안정 채널이 필요하면 토스증권(위) 또는 KRX AUTH_KEY 발급을 권장한다.
#        (KRX AUTH_KEY 연동은 인증키 발급 후 별도 구현 필요 — 현재 미배선.)
# 비활성화하려면 false.
KRX_ENABLED=true

# ---------------------------------------------------------------------------
# 공공데이터포털 (data.go.kr) — ETF 전종목 목록/시세 [ETF 유니버스 확보용]
# ---------------------------------------------------------------------------
# 용도: Toss 는 "전체 ETF 목록" 열거 API 가 없으므로, ETF 종목코드 유니버스를 여기서 확보한다.
#       (목록·코드 확보 → 실시간 시세는 Toss 로 조회하는 조합)
# 데이터셋: 금융위원회_증권상품시세정보 (data.go.kr id 15094806) > 오퍼레이션 "ETF 시세".
#           종목코드·종목명·시가/종가/고가/저가/거래량/변동률 제공. 갱신 T+1(전영업일→익영업일 13시 이후).
# 키 발급: data.go.kr 로그인 > 위 데이터셋 "활용신청"(개발/운영 모두 자동승인=즉시) > 마이페이지 인증키.
#          Toss/DART 키와 별개의 data.go.kr 전용 serviceKey 다. 무료.
# 아래에 발급받은 인증키(디코딩 키 권장)를 그대로 붙여넣는다.
PUBLICDATA_SERVICE_KEY=
# ETF 시세 엔드포인트(기본값 = 활용가이드 기준). 필요 시에만 수정.
PUBLICDATA_ETF_PRICE_URL=https://apis.data.go.kr/1160100/service/GetSecuritiesProductInfoService/getETFPriceInfo
# ETF 목록 provider 활성화 스위치(연동 구현 후 사용). 지금은 키만 넣어두면 된다.
PUBLICDATA_ENABLED=false

# ---------------------------------------------------------------------------
# DART 전자공시 OpenAPI (opendart.fss.or.kr) — 공식 API, 키 필요
# ---------------------------------------------------------------------------
# 발급: https://opendart.fss.or.kr 회원가입 후 인증키 발급.
# 아래에 본인 키를 직접 입력한다(예시값 없음).
DART_API_KEY=

# ---------------------------------------------------------------------------
# 증권사 오픈API (실시간/지연 시세·기본정보) — 자격정보 필요
# ---------------------------------------------------------------------------
# 각 증권사가 발급하는 앱키/시크릿을 직접 입력한다. base URL 은 해당 증권사 문서를 따른다.
# base URL 의 호스트는 allowlist 로 강제되므로, 실제 호출하려면 해당 호스트가 허용돼야 한다
# (server/lib/http.js 및 broker provider 참조).
BROKER_API_BASE_URL=
BROKER_API_KEY=
BROKER_API_SECRET=
BROKER_ACCOUNT_PROFILE=

# ---------------------------------------------------------------------------
# 운용사 공식 공개 데이터(구성종목·분배 일정) — 다운로드 URL 필요
# ---------------------------------------------------------------------------
# 운용사 공식 공개 구성종목 자료. 현재 TIGER PDF 조회를 지원한다.
# 로그인/API 키는 필요 없지만 외부 요청이므로 명시적으로 켠 경우에만 사용한다.
ISSUER_ENABLED=false
# 테스트/장애대응용 override. 비우면 공식 기본 URL 사용.
ISSUER_TIGER_PDF_URL=

# ---------------------------------------------------------------------------
# 스크래핑 provider(공식 API 부재) — 기본 비활성
# ---------------------------------------------------------------------------
# KIND/SEIBRO 는 공식 API 가 없어 HTML/PDF 스크래핑이 필요하다.
# robots.txt·약관·호출제한·재배포·HTML 변경 리스크 때문에 운영 기본 provider 로 채택하지 않는다.
# true 로 켜더라도 스크래핑 파서 구현 전까지는 미지원으로 정직하게 표기된다.
KIND_ENABLED=false
SEIBRO_ENABLED=false
# Reverse-search LLM planner (OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:4174
OPENROUTER_APP_NAME=ETF Hub Reverse Search
OPENROUTER_TIMEOUT_MS=30000
OPENROUTER_RETRIES=0
